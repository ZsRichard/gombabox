<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#46543c">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="GombaBox">
    <title>GombaBox - Mushroom Growing System</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <!-- Custom Styles -->
    <link href="/static/css/styles.css?v=15" rel="stylesheet">
    <link rel="icon" type="image/png" sizes="192x192" href="/static/icons/icon-192.png">
    <link rel="apple-touch-icon" href="/static/icons/icon-192.png">
    <link rel="manifest" href="/manifest.webmanifest">
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.js"></script>
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark sticky-top">
        <div class="container-lg">
            <a class="navbar-brand" href="/">
                <i class="fas fa-mushroom"></i> GombaBox
            </a>
            <div class="navbar-actions">
                <button type="button" id="notification-indicator" class="navbar-notification status-unknown"
                        aria-expanded="false" aria-controls="notification-dropdown" aria-label="Értesítési beállítások" title="Értesítési beállítások">
                    <span class="navbar-notification-icon" aria-hidden="true">
                        <i id="notification-indicator-icon" class="fas fa-bell"></i>
                    </span>
                    <span id="notification-indicator-count" class="navbar-notification-count d-none" aria-hidden="true">0</span>
                </button>
                <section id="notification-dropdown" class="notification-dropdown" aria-label="Korábbi értesítések" hidden>
                    <div class="d-flex align-items-center justify-content-between gap-2 mb-3">
                        <strong>Értesítések</strong>
                        <button type="button" id="notification-read-all" class="btn btn-sm btn-outline-primary">Összes olvasott</button>
                    </div>
                    <p id="notification-dropdown-status" class="small" role="status"></p>
                    <ul id="notification-dropdown-list" class="list-unstyled mb-2"></ul>
                    <button type="button" id="notification-open-settings" class="btn btn-sm btn-outline-primary w-100">Értesítési beállítások</button>
                </section>
                <div id="navbar-system-status" class="navbar-system-status status-loading" role="status" aria-live="polite">
                    <span class="navbar-status-icon" aria-hidden="true">
                        <i id="status-icon" class="fas fa-spinner fa-spin"></i>
                    </span>
                    <span class="navbar-status-copy">
                        <strong id="system-status">Checking system</strong>
                        <small id="system-status-detail">Connecting to GombaBox</small>
                    </span>
                    <span class="navbar-status-badge" id="status-badge">Checking</span>
                </div>
            </div>
        </div>
    </nav>

    <div class="container-lg mt-4">
        <!-- Main Tabs -->
        <ul class="nav nav-tabs" role="tablist">
            <li class="nav-item">
                <a class="nav-link active" data-bs-toggle="tab" href="#dashboard-tab">Dashboard</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-bs-toggle="tab" href="#controls-tab">Controls</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-bs-toggle="tab" href="#settings-tab">Settings</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-bs-toggle="tab" href="#logs-tab">Logs</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-bs-toggle="tab" href="#database-tab">Database</a>
            </li>
        </ul>

        <!-- Tab Content -->
        <div class="tab-content">
            <!-- Dashboard Tab -->
            <div id="dashboard-tab" class="tab-pane fade show active">
                <!-- Desktop overview: sensors around the latest capture -->
                <div class="row g-4 mt-1 dashboard-overview align-items-stretch">
                    <div class="col-12 col-lg-3 sensor-stack">
                        <div class="card sensor-card temperature-card">
                            <div class="card-header">
                                <i class="fas fa-thermometer-half"></i> Temperature
                            </div>
                            <div class="card-body text-center">
                                <div class="sensor-value" id="temp-value">--</div>
                                <div class="sensor-unit">°C</div>
                                <div class="sensor-label">Current Reading</div>
                            </div>
                        </div>
                        <div class="card sensor-card humidity-card">
                            <div class="card-header">
                                <i class="fas fa-water"></i> Humidity
                            </div>
                            <div class="card-body text-center">
                                <div class="sensor-value" id="hum-value">--</div>
                                <div class="sensor-unit">%</div>
                                <div class="sensor-label">Current Reading</div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-lg-6">
                        <div class="card capture-card h-100">
                            <div class="card-header">
                                <i class="fas fa-image"></i> Latest Capture
                            </div>
                            <div class="card-body text-center d-flex flex-column">
                                <img id="latest-capture" src="/static/icons/icon.svg" alt="Latest image"
                                     class="img-fluid latest-capture-img">
                                <div class="mt-3 d-none" id="latest-capture-coverage">
                                    <strong>Mycelium Coverage:</strong>
                                    <div class="progress mt-2">
                                        <div id="coverage-bar" class="progress-bar bg-success" role="progressbar"
                                             style="width: 0%"></div>
                                    </div>
                                    <span id="coverage-percentage">0%</span>
                                </div>
                                <div class="mt-3">
                                    <button class="btn btn-primary" id="capture-now-btn" onclick="captureNow(event)">
                                        <i class="fas fa-camera"></i> Capture Now
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-lg-3 sensor-stack">
                        <div class="card sensor-card co2-card">
                            <div class="card-header">
                                <i class="fas fa-cloud"></i> CO₂ Level
                            </div>
                            <div class="card-body text-center">
                                <div class="sensor-value" id="co2-value">--</div>
                                <div class="sensor-unit">ppm</div>
                                <div class="sensor-label">Current Reading</div>
                            </div>
                        </div>
                        <div class="card sensor-card light-card">
                            <div class="card-header">
                                <i class="fas fa-sun"></i> Light Level
                            </div>
                            <div class="card-body text-center">
                                <div class="sensor-value" id="light-value">--</div>
                                <div class="sensor-unit">lux</div>
                                <div class="sensor-label">Current Reading</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Time Range Selector -->
                <div class="row mt-4">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-body">
                                <label for="time-range-select" class="form-label">
                                    <i class="fas fa-calendar"></i> Chart Time Range
                                </label>
                                <div class="btn-group flex-wrap" role="group">
                                    <input type="radio" class="btn-check" name="time-range" id="time-1h" value="1" checked>
                                    <label class="btn btn-outline-primary" for="time-1h">1 Hour</label>

                                    <input type="radio" class="btn-check" name="time-range" id="time-6h" value="6">
                                    <label class="btn btn-outline-primary" for="time-6h">6 Hours</label>

                                    <input type="radio" class="btn-check" name="time-range" id="time-24h" value="24">
                                    <label class="btn btn-outline-primary" for="time-24h">24 Hours</label>

                                    <input type="radio" class="btn-check" name="time-range" id="time-7d" value="168">
                                    <label class="btn btn-outline-primary" for="time-7d">7 Days</label>

                                    <input type="radio" class="btn-check" name="time-range" id="time-30d" value="720">
                                    <label class="btn btn-outline-primary" for="time-30d">30 Days</label>

                                    <input type="radio" class="btn-check" name="time-range" id="time-custom" value="custom">
                                    <label class="btn btn-outline-primary" for="time-custom">Custom</label>
                                </div>
                                <div id="custom-chart-range" class="row g-2 align-items-end mt-2 d-none">
                                    <div class="col-md-5">
                                        <label for="chart-start-date" class="form-label mb-1">From</label>
                                        <input type="text" class="form-control custom-calendar-input" id="chart-start-date" readonly autocomplete="off" aria-haspopup="dialog">
                                    </div>
                                    <div class="col-md-5">
                                        <label for="chart-end-date" class="form-label mb-1">To</label>
                                        <input type="text" class="form-control custom-calendar-input" id="chart-end-date" readonly autocomplete="off" aria-haspopup="dialog">
                                    </div>
                                    <div class="col-md-2">
                                        <button type="button" class="btn btn-primary w-100" id="apply-chart-range">Apply</button>
                                    </div>
                                </div>
                                <div class="phase-help mt-3" id="chart-phase-help">
                                    <span class="phase-legend phase-colonization">Incubation</span>
                                    <span class="phase-legend phase-fruiting">Fruiting</span>
                                    <small class="text-muted d-block mt-1" id="chart-range-info">Loading chart data...</small>
                                    <div class="phase-calendar phase-calendar-popup mt-3" id="chart-calendar-popup" aria-label="Growth phase calendar" aria-hidden="true">
                                        <div class="phase-calendar-header">
                                            <button type="button" class="btn btn-sm btn-outline-secondary" id="phase-calendar-prev" aria-label="Previous month">
                                                <i class="fas fa-chevron-left"></i>
                                            </button>
                                            <strong id="phase-calendar-title"></strong>
                                            <button type="button" class="btn btn-sm btn-outline-secondary" id="phase-calendar-next" aria-label="Next month">
                                                <i class="fas fa-chevron-right"></i>
                                            </button>
                                        </div>
                                        <div class="phase-calendar-grid" id="phase-calendar-grid"></div>
                                        <small class="text-muted d-block mt-2"><span class="history-data-dot" aria-hidden="true"></span> Mentett mérés vagy felvétel. A háttérszín a termesztési fázist jelöli.</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Coverage Trend Chart -->
                <div class="row mt-4" id="coverage-chart-section">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <i class="fas fa-chart-line"></i> Mycelium Coverage Trend
                            </div>
                            <div class="card-body">
                                <div class="chart-container">
                                    <canvas id="coverage-chart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                {# Coverage Test Lab temporarily hidden.
                <div class="row mt-4">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <i class="fas fa-flask"></i> Coverage Test Lab
                            </div>
                            <div class="card-body">
                                <div class="row g-3 align-items-end">
                                    <div class="col-md-3">
                                        <label for="coverage-preview-start" class="form-label">Preview start</label>
                                        <input type="datetime-local" id="coverage-preview-start" class="form-control">
                                    </div>
                                    <div class="col-md-3">
                                        <label for="coverage-preview-end" class="form-label">Preview end</label>
                                        <input type="datetime-local" id="coverage-preview-end" class="form-control">
                                    </div>
                                    <div class="col-md-3">
                                        <label for="coverage-preview-sample-hours" class="form-label">Sample every</label>
                                        <input type="number" id="coverage-preview-sample-hours" class="form-control" min="1" step="1" value="1">
                                    </div>
                                    <div class="col-md-12 mt-3">
                                        <div class="row g-2">
                                            <div class="col-md-3">
                                                <label for="coverage-crop-top" class="form-label">Crop top (%)</label>
                                                <input type="range" id="coverage-crop-top" min="0" max="40" step="1" value="20" class="form-range">
                                                <small class="form-text text-muted"><span id="coverage-crop-top-val">20</span>%</small>
                                            </div>
                                            <div class="col-md-3">
                                                <label for="coverage-crop-left" class="form-label">Crop left (%)</label>
                                                <input type="range" id="coverage-crop-left" min="0" max="40" step="1" value="20" class="form-range">
                                                <small class="form-text text-muted"><span id="coverage-crop-left-val">20</span>%</small>
                                            </div>
                                            <div class="col-md-3">
                                                <label for="coverage-crop-right" class="form-label">Crop right (%)</label>
                                                <input type="range" id="coverage-crop-right" min="0" max="40" step="1" value="10" class="form-range">
                                                <small class="form-text text-muted"><span id="coverage-crop-right-val">10</span>%</small>
                                            </div>
                                            <div class="col-md-3">
                                                <label for="coverage-crop-bottom" class="form-label">Crop bottom (%)</label>
                                                <input type="range" id="coverage-crop-bottom" min="0" max="40" step="1" value="9" class="form-range">
                                                <small class="form-text text-muted"><span id="coverage-crop-bottom-val">9</span>%</small>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-3 d-flex gap-2">
                                        <button class="btn btn-outline-secondary flex-fill" type="button" onclick="useCoveragePreviewPreset(1)">1H</button>
                                        <button class="btn btn-outline-secondary flex-fill" type="button" onclick="useCoveragePreviewPreset(6)">6H</button>
                                        <button class="btn btn-outline-secondary flex-fill" type="button" onclick="useCoveragePreviewPreset(24)">24H</button>
                                    </div>
                                    <div class="col-md-3 d-flex">
                                        <button class="btn btn-outline-primary w-100" id="coverage-preview-btn" onclick="loadCoverageComparison()">
                                            <i class="fas fa-rotate"></i> Recalculate preview
                                        </button>
                                    </div>
                                </div>
                                <div class="mt-2">
                                    <small class="text-muted" id="chart-data-info">Select an interval to test the recalculation.</small>
                                </div>
                                <div class="mt-2">
                                    <small class="text-muted">Higher values sample fewer images and speed up long intervals.</small>
                                </div>
                                <div class="chart-container mt-3">
                                    <canvas id="coverage-test-chart"></canvas>
                                </div>
                                <div class="mt-4">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <strong>Original vs Preprocessed Image</strong>
                                        <small class="text-muted" id="coverage-preview-image-meta">Waiting for preview...</small>
                                    </div>
                                    <img id="coverage-preview-image" class="img-fluid rounded border w-100" src="/static/icons/icon.svg" alt="Coverage preprocessing preview">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                #}

                <!-- Time Series Graphs -->
                <div class="row mt-4">
                    <div class="col-lg-6">
                        <div class="card">
                            <div class="card-header">
                                <i class="fas fa-thermometer-half"></i> Temperature Trend
                            </div>
                            <div class="card-body">
                                <div class="chart-container">
                                    <canvas id="temp-chart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="card">
                            <div class="card-header">
                                <i class="fas fa-tint"></i> Humidity Trend
                            </div>
                            <div class="card-body">
                                <div class="chart-container">
                                    <canvas id="humidity-chart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row mt-4">
                    <div class="col-lg-6">
                        <div class="card">
                            <div class="card-header">
                                <i class="fas fa-cloud"></i> CO₂ Level Trend
                            </div>
                            <div class="card-body">
                                <div class="chart-container">
                                    <canvas id="co2-chart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="card">
                            <div class="card-header">
                                <i class="fas fa-sun"></i> Light Level Trend
                            </div>
                            <div class="card-body">
                                <div class="chart-container">
                                    <canvas id="light-chart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Timelapse Creator -->
                <div class="row mt-4">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <i class="fas fa-film"></i> Timelapse Creator
                            </div>
                            <div class="card-body">
                                <div class="row g-3 align-items-end">
                                    <div class="col-md-3">
                                        <label for="timelapse-start-date" class="form-label">Start time</label>
                                        <input type="text" class="form-control custom-calendar-input" id="timelapse-start-date" readonly autocomplete="off" aria-haspopup="dialog">
                                    </div>
                                    <div class="col-md-3">
                                        <label for="timelapse-end-date" class="form-label">End time</label>
                                        <input type="text" class="form-control custom-calendar-input" id="timelapse-end-date" readonly autocomplete="off" aria-haspopup="dialog">
                                    </div>
                                    <div class="col-md-3">
                                        <label for="timelapse-fps" class="form-label">FPS</label>
                                        <input type="number" min="1" max="60" step="1" value="15" class="form-control" id="timelapse-fps">
                                    </div>
                                    <div class="col-md-3 d-flex">
                                        <button class="btn btn-primary w-100" id="generate-timelapse-btn" onclick="generateTimelapse()">
                                            <i class="fas fa-wand-magic-sparkles"></i> Build
                                        </button>
                                    </div>
                                </div>
                                <div id="media-export-status" class="alert alert-custom alert-info-custom mt-3 d-none"></div>
                                <div id="timelapse-result" class="alert alert-custom alert-info-custom mt-3 d-none">
                                    Timelapse ready:
                                    <a id="timelapse-link" href="#" target="_blank" rel="noopener">Open video</a>
                                </div>
                                <div class="phase-help mt-3">
                                    <span class="phase-legend phase-colonization">Incubation</span>
                                    <span class="phase-legend phase-fruiting">Fruiting</span>
                                    <small class="text-muted d-block mt-1">Select the start day, then the end day.</small>
                                    <div class="phase-calendar phase-calendar-popup mt-3" id="timelapse-calendar-popup" aria-label="Timelapse growth phase calendar" aria-hidden="true">
                                        <div class="phase-calendar-header">
                                            <button type="button" class="btn btn-sm btn-outline-secondary" id="timelapse-calendar-prev" aria-label="Previous timelapse month">
                                                <i class="fas fa-chevron-left"></i>
                                            </button>
                                            <strong id="timelapse-calendar-title"></strong>
                                            <button type="button" class="btn btn-sm btn-outline-secondary" id="timelapse-calendar-next" aria-label="Next timelapse month">
                                                <i class="fas fa-chevron-right"></i>
                                            </button>
                                        </div>
                                        <div class="phase-calendar-grid" id="timelapse-calendar-grid"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Controls Tab -->
            <div id="controls-tab" class="tab-pane fade">
                <div class="row mt-4">
                    <div class="col-lg-8">
                        <div class="card">
                            <div class="card-header">
                                <i class="fas fa-gamepad"></i> Relay Controls
                            </div>
                            <div class="card-body">
                                <div id="relay-controls">
                                    <!-- Relay controls will be loaded here -->
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="card">
                            <div class="card-header">
                                <i class="fas fa-cog"></i> System Controls
                            </div>
                            <div class="card-body">
                                <button class="btn btn-success w-100 mb-2" onclick="startSystem()">
                                    <i class="fas fa-play"></i> Start System
                                </button>
                                <button class="btn btn-danger w-100" onclick="stopSystem()">
                                    <i class="fas fa-stop"></i> Stop System
                                </button>
                                <button class="btn btn-warning w-100 mt-2" onclick="restartSystem()">
                                    <i class="fas fa-rotate"></i> Restart Service
                                </button>
                            </div>
                        </div>
                        <div class="card mt-4">
                            <div class="card-header">
                                <i class="fas fa-seedling"></i> Growth Phase
                            </div>
                            <div class="card-body">
                                <label for="growth-phase" class="form-label">Phase</label>
                                <select id="growth-phase" class="form-select">
                                    <option value="colonization">Colonization</option>
                                    <option value="fruiting">Fruiting</option>
                                    <option value="stopped">Stopped (server only)</option>
                                </select>
                                <small class="form-text text-muted d-block mt-2" id="growth-phase-status"></small>
                                <button class="btn btn-primary w-100 mt-2" onclick="saveGrowthPhase()">
                                    Save Phase
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Settings Tab -->
            <div id="settings-tab" class="tab-pane fade">
                <div id="notification-center" class="card mt-4"></div>
                <div class="row mt-4">
                    <div class="col-lg-8">
                        <div class="card">
                            <div class="card-header">
                                <i class="fas fa-sliders-h"></i> Environment Settings
                            </div>
                            <div class="card-body" id="settings-form">
                                <!-- Settings will be loaded here -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Logs Tab -->
            <div id="logs-tab" class="tab-pane fade">
                <div class="row mt-4">
                    <div class="col-lg-12">
                        <div class="card">
                            <div class="card-header">
                                <i class="fas fa-list"></i> System Logs
                            </div>
                            <div class="card-body">
                                <details class="mb-3 text-muted small">
                                    <summary>Mi és mikor kerül a naplóba?</summary>
                                    <p class="mt-2 mb-1">A vezérlő az eszközök kapcsolását, az impulzusok okát és a képrögzítést naplózza. A szenzorok és a kamera a csatlakozást és a hibákat jelzik. A szerver az indulást, a beállítások módosítását és a kézi műveleteket rögzíti.</p>
                                    <p class="mb-0">INFO: normál esemény. WARNING: figyelmeztetés. ERROR: sikertelen művelet. A mérések a measurements táblába kerülnek, nem külön naplóbejegyzésként. Az azonos hibák egy percen belüli ismétléseit csak a Pi szolgáltatásnaplója tartalmazza. A legacy bejegyzések régebbiek, forrásuk nincs eltárolva.</p>
                                </details>
                                <div class="row g-2 mb-3">
                                    <div class="col-md-6"><label for="logs-search" class="form-label">Search</label><input type="search" id="logs-search" class="form-control" maxlength="200" placeholder="Message or source..."></div>
                                    <div class="col-md-3"><label for="logs-level" class="form-label">Level</label><select id="logs-level" class="form-select"><option value="">All levels</option><option>INFO</option><option>WARNING</option><option>ERROR</option><option>CRITICAL</option></select></div>
                                    <div class="col-md-3"><label for="logs-source" class="form-label">Source</label><select id="logs-source" class="form-select"><option value="">All sources</option><option>controller</option><option>sensors</option><option>camera</option><option>relays</option><option>server</option><option>storage</option><option>image-analysis</option><option>notifications</option><option>legacy</option></select></div>
                                    <div class="col-md-3"><label for="logs-start" class="form-label">From</label><input type="datetime-local" id="logs-start" class="form-control"></div>
                                    <div class="col-md-3"><label for="logs-end" class="form-label">To</label><input type="datetime-local" id="logs-end" class="form-control"></div>
                                    <div class="col-md-3"><label for="logs-sort" class="form-label">Sort by</label><select id="logs-sort" class="form-select"><option value="timestamp">Time</option><option value="level">Level</option><option value="source">Source</option><option value="id">ID</option></select></div>
                                    <div class="col-md-3"><label for="logs-direction" class="form-label">Order</label><select id="logs-direction" class="form-select"><option value="desc">Descending</option><option value="asc">Ascending</option></select></div>
                                    <div class="col-md-4"><label for="logs-limit" class="form-label">Rows per page</label><select id="logs-limit" class="form-select"><option>50</option><option>100</option><option>200</option></select></div>
                                    <div class="col-md-8 d-flex gap-2 align-items-end"><button id="logs-apply" class="btn btn-primary">Apply / Refresh</button><button id="logs-reset" class="btn btn-outline-secondary">Reset filters</button></div>
                                </div>
                                <div id="logs-alert" class="text-danger small mb-2" role="status"></div>
                                <div class="table-responsive"><table class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th>Timestamp</th>
                                            <th>Level</th>
                                            <th>Source</th>
                                            <th>Message</th>
                                        </tr>
                                    </thead>
                                    <tbody id="logs-table">
                                        <!-- Logs will be loaded here -->
                                    </tbody>
                                </table></div>
                                <div class="d-flex justify-content-between align-items-center mt-3"><button id="logs-prev" class="btn btn-outline-secondary">Prev</button><span id="logs-page-info" aria-live="polite"></span><button id="logs-next" class="btn btn-outline-secondary">Next</button></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Database Tab -->
            <div id="database-tab" class="tab-pane fade">
                <div class="row mt-4">
                    <div class="col-lg-12">
                        <div class="card">
                            <div class="card-header">
                                <i class="fas fa-database"></i> Database Browser
                            </div>
                            <div class="card-body">
                                <div class="row g-3 align-items-end">
                                    <div class="col-md-4">
                                        <label class="form-label" for="db-table-select">Table</label>
                                        <select id="db-table-select" class="form-select"></select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label" for="db-table-limit">Rows per page</label>
                                        <select id="db-table-limit" class="form-select">
                                            <option value="50" selected>50</option>
                                            <option value="100">100</option>
                                            <option value="200">200</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <button class="btn btn-primary w-100" id="db-refresh-btn">
                                            <i class="fas fa-sync"></i> Refresh
                                        </button>
                                    </div>
                                </div>
                                <div class="row g-2 mt-2">
                                    <div class="col-md-6"><label for="db-search" class="form-label">Search all columns</label><input type="search" id="db-search" class="form-control" maxlength="200"></div>
                                    <div class="col-md-3"><label for="db-sort" class="form-label">Sort by</label><select id="db-sort" class="form-select"></select></div>
                                    <div class="col-md-3"><label for="db-direction" class="form-label">Order</label><select id="db-direction" class="form-select"><option value="desc">Descending</option><option value="asc">Ascending</option></select></div>
                                    <div class="col-md-3"><label for="db-filter-column" class="form-label">Filter column</label><select id="db-filter-column" class="form-select"></select></div>
                                    <div class="col-md-3"><label for="db-filter-op" class="form-label">Condition</label><select id="db-filter-op" class="form-select"><option value="eq">Equals</option><option value="contains">Contains</option><option value="gte">At least</option><option value="lte">At most</option><option value="null">Empty (NULL)</option><option value="notnull">Not empty</option></select></div>
                                    <div class="col-md-6"><label for="db-filter-value" class="form-label">Value</label><input type="text" id="db-filter-value" class="form-control"></div>
                                    <div class="col-md-4"><label for="db-start" class="form-label">From</label><input type="datetime-local" id="db-start" class="form-control"></div>
                                    <div class="col-md-4"><label for="db-end" class="form-label">To</label><input type="datetime-local" id="db-end" class="form-control"></div>
                                    <div class="col-md-4 d-flex gap-2 align-items-end"><button id="db-apply" class="btn btn-primary">Apply</button><button id="db-reset" class="btn btn-outline-secondary">Reset filters</button></div>
                                </div>
                                <div id="db-alert" class="alert alert-warning-custom mt-3" style="display:none"></div>
                                <div class="table-responsive mt-3">
                                    <table class="table table-hover" id="db-table">
                                        <thead id="db-table-head"></thead>
                                        <tbody id="db-table-body"></tbody>
                                    </table>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    <button class="btn btn-outline-secondary" id="db-prev-btn">Prev</button>
                                    <span id="db-page-info">Page 1</span>
                                    <button class="btn btn-outline-secondary" id="db-next-btn">Next</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="db-edit-modal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Row</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="db-edit-form"></form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="db-save-btn">Save</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="notification-opt-in-modal" tabindex="-1"
         aria-labelledby="notification-opt-in-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content notification-opt-in">
                <div class="modal-body text-center p-4 p-sm-5">
                    <span class="notification-opt-in-icon" aria-hidden="true"><i class="fas fa-bell"></i></span>
                    <h5 class="mt-3" id="notification-opt-in-title">Bekapcsolod az értesítéseket?</h5>
                    <p class="text-muted mb-4">A GombaBox akkor is tud jelezni a fontos eltérésekről, amikor az alkalmazás nincs megnyitva.</p>
                    <p id="notification-opt-in-info" class="small text-danger" role="status"></p>
                    <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
                        <button type="button" class="btn btn-primary" id="notification-opt-in-enable">
                            <i class="fas fa-bell me-1" aria-hidden="true"></i> Bekapcsolás
                        </button>
                        <button type="button" class="btn btn-outline-secondary" id="notification-opt-in-later" data-bs-dismiss="modal">Most nem</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="footer">
        <p>&copy; 2026 GombaBox - Automated Mushroom Growing System. All rights reserved.</p>
        <small>Last updated: <span id="last-update">--:--:--</span></small>
    </footer>

    <button id="install-app-btn" class="pwa-install-fab d-none" type="button"
            aria-label="GombaBox app telepítése" title="GombaBox app telepítése">
        <span class="pwa-install-icon" aria-hidden="true">
            <i class="fas fa-mobile-screen-button"></i>
            <i class="fas fa-arrow-down pwa-install-icon-arrow"></i>
        </span>
        <span class="visually-hidden">GombaBox app telepítése</span>
    </button>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- PWA Diagnostic Panel -->
    <!-- Frontend JavaScript -->
    <script src="/static/js/dashboard.js?v=19"></script>
    <script src="/static/js/notifications.js?v=5"></script>
</body>
</html>
